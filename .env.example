# Sponsor account that pays for Shelby blob writes (leaderboard / passport / replay)
VITE_SPONSOR_PRIVATE_KEY=0x...

# Geomi / Shelby API key (from https://geomi.dev or your Shelby CLI context api_key)
# Recommended to avoid anonymous rate limits: https://docs.shelby.xyz/sdks/typescript/acquire-api-keys
VITE_SHELBY_API_KEY=aptoslabs_...

# Optional: "shelbynet" (default) or "testnet"
# VITE_SHELBY_NETWORK=shelbynet
